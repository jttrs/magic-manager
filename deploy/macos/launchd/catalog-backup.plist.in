<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Rendered by deploy/macos/install.sh — edit the template, then re-run the installer. -->
<plist version="1.0"><dict>
  <key>Label</key><string>com.magic-manager.hosted.catalog-backup</string>
  <key>ProgramArguments</key><array><string>/bin/bash</string><string>@KIT@/catalog-backup.sh</string></array>
  <key>StartCalendarInterval</key><dict>
    <key>Weekday</key><integer>0</integer>
    <key>Hour</key><integer>4</integer>
    <key>Minute</key><integer>17</integer>
  </dict>
  <key>ProcessType</key><string>Background</string>
  <key>Umask</key><integer>63</integer>
  <key>StandardOutPath</key><string>@LOGS@/catalog-backup.log</string>
  <key>StandardErrorPath</key><string>@LOGS@/catalog-backup.log</string>
</dict></plist>
