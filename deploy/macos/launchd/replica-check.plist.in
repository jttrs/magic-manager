<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Rendered by deploy/macos/install.sh — edit the template, then re-run the installer. -->
<plist version="1.0"><dict>
  <key>Label</key><string>com.magic-manager.hosted.replica-check</string>
  <key>ProgramArguments</key><array><string>/bin/bash</string><string>@KIT@/replica-check.sh</string></array>
  <key>StartInterval</key><integer>900</integer>
  <key>ProcessType</key><string>Background</string>
  <key>Umask</key><integer>63</integer>
  <key>StandardOutPath</key><string>@LOGS@/replica-check.log</string>
  <key>StandardErrorPath</key><string>@LOGS@/replica-check.log</string>
</dict></plist>
