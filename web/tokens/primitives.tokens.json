      "normal": { "$value": 100 }
    },
    "wght": {
      "$type": "fontWeight",
      "regular": { "$value": 400 },
      "medium": { "$value": 520 },
      "bold": { "$value": 680 }
    },
    "size": {
      "$type": "dimension",
      "2xs": { "$value": "0.6875rem" },
      "xs": { "$value": "0.75rem" },
      "sm": { "$value": "0.8125rem" },
      "md": { "$value": "0.9375rem" },
      "lg": { "$value": "1.125rem" },
      "xl": { "$value": "1.375rem" },
      "2xl": { "$value": "1.75rem" },
      "3xl": { "$value": "2.25rem" }
    }
  },
  "space": {
    "$type": "dimension",
    "px": { "$value": "1px" },
    "0-5": { "$value": "0.125rem" },
    "1": { "$value": "0.25rem" },
    "1-5": { "$value": "0.375rem" },
    "2": { "$value": "0.5rem" },
    "3": { "$value": "0.75rem" },
    "4": { "$value": "1rem" },
    "5": { "$value": "1.25rem" },
    "6": { "$value": "1.5rem" },
    "8": { "$value": "2rem" },
    "10": { "$value": "2.5rem" },
    "12": { "$value": "3rem" }
