  "radius": {
    "$type": "dimension",
    "none": { "$value": "0" },
    "xs": { "$value": "2px" },
    "sm": { "$value": "3px" },
    "pill": { "$value": "999px" }
  },
  "size": {
    "$type": "dimension",
    "topbar": { "$value": "3.5rem" },
    "sidebar": { "$value": "16rem" },
    "card-w": { "$value": "7.5rem" },
    "row-h": { "$value": "2rem" },
    "thumb": { "$value": "1.5rem" }
  },
  "motion": {
    "duration": {
      "$type": "duration",
      "fast": { "$value": "120ms" },
      "base": { "$value": "180ms" },
      "slow": { "$value": "260ms" }
    },
    "ease": {
      "$type": "cubicBezier",
      "out": { "$value": [0.16, 1, 0.3, 1] }
    }
  }
}
