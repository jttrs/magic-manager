  "font": {
    "family": {
      "$type": "fontFamily",
      "guide": { "$value": ["Archivo Variable", "Archivo", "Helvetica Neue", "Arial Narrow", "sans-serif"] }
    },
    "width": {
      "$type": "number",
      "condensed": { "$value": 72 },
