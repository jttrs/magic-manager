      "800": { "$value": "#221e17" },
      "700": { "$value": "#2e2920" },
      "600": { "$value": "#433c30" }
    },
    "bone": {
      "50": { "$value": "#f7f2e7" },
      "100": { "$value": "#efe7d6" },
      "200": { "$value": "#e4dac4" },
      "300": { "$value": "#d3c6aa" }
    },
    "ink": {
      "900": { "$value": "#1d1912" },
      "700": { "$value": "#3d3529" },
      "600": { "$value": "#625846" }
    },
    "taupe": {
      "400": { "$value": "#a59b87" },
      "500": { "$value": "#8a8170" }
    },
    "amber": {
      "300": { "$value": "#f7c66b" },
