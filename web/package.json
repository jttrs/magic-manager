{
  "name": "magic-manager-web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run tokens && tsc -b && vite build",
    "tokens": "node tokens/build.mjs",
    "gen:api": "uv run --project .. python ../scripts/dump_openapi.py && openapi-ts",
    "lint": "oxlint src && stylelint \"src/**/*.css\"",
    "test": "vitest run",
    "e2e": "playwright test",
    "preview": "vite preview",
    "check:arch": "depcruise src --config .dependency-cruiser.cjs",
    "check:dead": "knip",
    "check": "tsc -b && npm run lint && npm run check:arch && npm run check:dead && npm test"
  },
  "dependencies": {
    "@atlaskit/pragmatic-drag-and-drop": "^4.0.0",
    "@atlaskit/pragmatic-drag-and-drop-hitbox": "^3.0.0",
    "@fontsource-variable/archivo": "^5.3.0",
    "@tanstack/react-query": "^5.104.1",
    "@tanstack/react-router": "^1.170.41",
    "@tanstack/react-virtual": "^3.14.13",
    "radix-ui": "^1.6.7",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-resizable-panels": "^4.14.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@hey-api/openapi-ts": "^0.99.0",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "dependency-cruiser": "^17.4.3",
    "knip": "^6.39.0",
    "oxlint": "^1.81.0",
    "style-dictionary": "^5.5.5",
    "stylelint": "^17.16.0",
    "stylelint-config-standard": "^40.0.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vitest": "^4.1.11"
  }
}
