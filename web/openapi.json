            "title": "Image Uri"
          },
          "scryfall_url": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Scryfall Url"
          },
          "treatment": {
            "type": "string",
            "title": "Treatment",
            "description": "Treatment codes (b, fa, shw, ext, sm, ff; '|'-joined); '' = plain"
          },
          "standard_frame": {
            "type": "boolean",
            "title": "Standard Frame"
          },
          "is_bulk": {
            "type": "boolean",
            "title": "Is Bulk"
          },
          "is_chase": {
            "type": "boolean",
            "title": "Is Chase"
          }
        },
        "type": "object",
        "required": [
          "scryfall_id",
          "oracle_id",
          "name",
          "family",
          "set_code",
          "collector_number",
          "rarity",
          "type_line",
          "cmc",
          "color_identity",
          "released_at",
          "finishes",
          "owned",
          "pledged",
          "price_usd",
          "price_usd_foil",
          "image_uri",
          "scryfall_url",
          "treatment",
          "standard_frame",
          "is_bulk",
          "is_chase"
