            "title": "Finishes"
          },
          "owned": {
            "additionalProperties": {
              "type": "integer"
            },
            "type": "object",
            "title": "Owned",
            "description": "finish -> owned copies"
          },
          "pledged": {
            "additionalProperties": {
              "type": "integer"
            },
            "type": "object",
            "title": "Pledged",
            "description": "finish -> copies pledged to built decks"
          },
          "price_usd": {
            "anyOf": [
              {
                "type": "number"
              },
