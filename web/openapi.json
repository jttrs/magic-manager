          "finish": {
            "type": "string",
            "enum": [
              "nonfoil",
              "foil"
            ],
            "title": "Finish"
          },
          "qty": {
            "type": "integer",
            "minimum": 1.0,
            "title": "Qty",
            "default": 1
          }
        },
        "type": "object",
        "required": [
          "scryfall_id",
          "finish"
        ],
        "title": "BuyItem"
      },
      "BuyListIn": {
        "properties": {
          "target": {
            "type": "string",
